{
  "name": "grugops-tooling",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:e2e": "vitest run scripts/e2e",
    "freshness": "tsc --outDir .tmp-build && node scripts/freshness.js",
    "check:build-parity": "npm run build && git diff --exit-code --name-only -- '*.js' && echo 'Build parity: no tracked build output moved when tsc ran.' || node -e \"console.error('BUILD PARITY FAILED: either the build did not complete, or it moved one of the tracked build outputs named above - meaning a committed .js on this tree is not a build of its .ts. Remedy: run npm run build and commit the result.'); process.exit(1)\"",
    "check:public-docs": "tsc --outDir .tmp-build && node scripts/check-public-docs-vocabulary.js",
    "check:audit-register": "tsc --outDir .tmp-build && node scripts/check-audit-register.js",
    "check:claim-anchors": "tsc --outDir .tmp-build && node scripts/check-claim-anchors.js",
    "check:banned-claims": "tsc --outDir .tmp-build && node scripts/check-banned-claims.js",
    "check:imperative-lexicon": "tsc --outDir .tmp-build && node scripts/check-imperative-lexicon.js",
    "check:diff-disposition": "tsc --outDir .tmp-build && node scripts/check-diff-disposition.js",
    "check:nul-bytes": "tsc --outDir .tmp-build && node scripts/check-nul-bytes.js",
    "audit:prepass": "tsc --outDir .tmp-build && node scripts/audit-prepass.js",
    "generate:safety-surface": "tsc --outDir .tmp-build && node scripts/generate-safety-surface.js",
    "generate:catalog": "tsc --outDir .tmp-build && node scripts/generate-catalog.js",
    "generate:adapters": "tsc --outDir .tmp-build && node scripts/generate-role-adapters.js",
    "generate:skill-twins": "tsc --outDir .tmp-build && node scripts/generate-skill-twins.js",
    "freshness:catalog": "tsc --outDir .tmp-build && node scripts/catalog-freshness.js",
    "freshness:adapters": "tsc --outDir .tmp-build && node scripts/adapters-freshness.js",
    "freshness:skill-twins": "tsc --outDir .tmp-build && node scripts/skill-twins-freshness.js",
    "freshness:context": "tsc --outDir .tmp-build && node scripts/context-freshness.js",
    "freshness:queue": "tsc --outDir .tmp-build && node scripts/now-running-freshness.js",
    "freshness:traceability": "tsc --outDir .tmp-build && node scripts/trace-freshness.js",
    "count:lines": "tokei"
  },
  "devDependencies": {
    "@types/node": "~22",
    "typescript": "~6.0.3",
    "vitest": "~4.1.8"
  }
}
