{
  "auth status": { "exit": 0 },
  "api --method GET -i repos/{owner}/{repo}": { "status": 200, "body": { "default_branch": "main", "full_name": "octo/repo", "url": "https://api.github.com/repos/octo/repo" } },
  "api --method GET -i repos/{owner}/{repo}/rules/branches/main?per_page=100": {
    "status": 200,
    "body": [
      {
        "type": "pull_request",
        "parameters": { "required_approving_review_count": 1 },
        "ruleset_source_type": "Repository",
        "ruleset_source": "octo/repo",
        "ruleset_id": 1
      },
      { "type": "non_fast_forward", "ruleset_source_type": "Repository", "ruleset_source": "octo/repo", "ruleset_id": 1 },
      { "type": "deletion", "ruleset_source_type": "Repository", "ruleset_source": "octo/repo", "ruleset_id": 1 }
    ]
  },
  "api --method GET -i repos/{owner}/{repo}/rulesets/1": {
    "status": 200,
    "body": {
      "id": 1,
      "target": "branch",
      "enforcement": "active",
      "source": "octo/repo",
      "source_type": "Repository",
      "current_user_can_bypass": "never"
    }
  },
  "api --method GET -i repos/{owner}/{repo}/branches/master":{ "status": 404, "body": { "message": "Branch not found" } }
}
